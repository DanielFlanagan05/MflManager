<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF7F9FC" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FF0F6CBD" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF107C10" />
            <SolidColorBrush x:Key="AppSecondaryBrush" Color="#FF5D6670" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF17191C" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FF23262A" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="AppSecondaryBrush" Color="#FFB1B8C0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="AppSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="AppCardBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="AppPrimaryBrush" ResourceKey="SystemColorHotlightColorBrush" />
            <StaticResource x:Key="AppSuccessBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="AppSecondaryBrush" ResourceKey="SystemColorGrayTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
