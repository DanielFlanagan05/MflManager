<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MflManager.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MflManager.App"
    xmlns:viewModels="using:MflManager.App.ViewModels"
    Background="{ThemeResource AppSurfaceBrush}">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked" />
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="AgentAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="NavigationAccelerator_Invoked" />
        <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextAreaAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <NavigationView x:Name="Navigation" AutomationProperties.AutomationId="PrimaryNavigation" AutomationProperties.Name="Application navigation" SelectionChanged="Navigation_SelectionChanged" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Left">
        <NavigationView.MenuItems>
            <NavigationViewItem AutomationProperties.AutomationId="NavDashboard" Content="Dashboard" Tag="Dashboard" />
            <NavigationViewItem AutomationProperties.AutomationId="NavMyTeam" Content="My Team" Tag="My Team" />
            <NavigationViewItem AutomationProperties.AutomationId="NavPlayers" Content="Players" Tag="Players" />
            <NavigationViewItem AutomationProperties.AutomationId="NavRankings" Content="Rankings" Tag="Rankings" />
            <NavigationViewItem AutomationProperties.AutomationId="NavDraft" Content="Draft" Tag="Draft" />
            <NavigationViewItem AutomationProperties.AutomationId="NavWaivers" Content="Waivers" Tag="Waivers" />
            <NavigationViewItem AutomationProperties.AutomationId="NavTrades" Content="Trades" Tag="Trades" />
            <NavigationViewItem AutomationProperties.AutomationId="NavMatchups" Content="Matchups" Tag="Matchups" />
            <NavigationViewItem AutomationProperties.AutomationId="NavStandings" Content="Standings" Tag="Standings" />
            <NavigationViewItem AutomationProperties.AutomationId="NavLeague" Content="League" Tag="League" />
            <NavigationViewItem AutomationProperties.AutomationId="NavMessages" Content="Messages" Tag="Messages" />
            <NavigationViewItem AutomationProperties.AutomationId="NavAgent" Content="Agent" Tag="Agent" />
        </NavigationView.MenuItems>
        <Grid Padding="24" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Foreground="{ThemeResource AppSecondaryBrush}" />
                </StackPanel>
                <ComboBox x:Name="LeagueSelector" Grid.Column="1" AutomationProperties.AutomationId="LeagueSelector" Header="League" ItemsSource="{x:Bind ViewModel.Leagues, Mode=OneWay}" DisplayMemberPath="Name" SelectionChanged="LeagueSelector_SelectionChanged" MinWidth="240" />
            </Grid>
            <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
                <CommandBar.Content><AutoSuggestBox x:Name="GlobalSearch" AutomationProperties.AutomationId="GlobalPlayerSearch" PlaceholderText="Search current view" TextChanged="GlobalSearch_TextChanged" MinWidth="280" /></CommandBar.Content>
                <AppBarButton AutomationProperties.AutomationId="RefreshAllButton" AutomationProperties.Name="Refresh all league data" Command="{x:Bind ViewModel.RefreshCommand}" Icon="Refresh" Label="Refresh all" />
                <AppBarButton AutomationProperties.AutomationId="SignOutButton" Command="{x:Bind ViewModel.SignOutCommand}" Icon="LeaveChat" Label="Sign out" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsSignedIn), Mode=OneWay}" />
                <AppBarButton AutomationProperties.AutomationId="SignInButton" Click="SignIn_Click" Icon="Contact" Label="Sign in" Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.IsSignedIn), Mode=OneWay}" />
            </CommandBar>
            <InfoBar Grid.Row="2" AutomationProperties.AutomationId="ApplicationStatus" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="Informational" Title="MFL Manager" />
            <Grid Grid.Row="3" ColumnSpacing="8" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsDraftPage), Mode=OneWay}" AutomationProperties.AutomationId="DraftQueueControls">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Queue" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.DraftQueueHead, Mode=OneWay}" Foreground="{ThemeResource AppSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                <TextBox Grid.Column="1" AutomationProperties.AutomationId="DraftQueuePlayerSearch" PlaceholderText="Add player by name" Text="{x:Bind ViewModel.DraftQueuePlayerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" AutomationProperties.AutomationId="AddDraftQueuePlayerButton" Command="{x:Bind ViewModel.AddDraftQueuePlayerCommand}" Content="Add" />
                <Button Grid.Column="3" AutomationProperties.AutomationId="ViewDraftQueueButton" Content="View queue">
                    <Button.Flyout>
                        <Flyout>
                            <Grid Width="600" Height="320" RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="12,4" ColumnSpacing="16" AutomationProperties.AutomationId="DraftQueueHeader">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Order" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="1" Text="Player" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="2" Text="Position" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="3" Text="Team" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                                <ListView Grid.Row="1" AutomationProperties.AutomationId="DraftQueueList" ItemsSource="{x:Bind ViewModel.DraftQueue, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="viewModels:DraftQueueRow"><Grid Padding="12,8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Order}" /><TextBlock Grid.Column="1" Text="{x:Bind PlayerName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{x:Bind Position}" /><TextBlock Grid.Column="3" Text="{x:Bind Team}" /></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="4" AutomationProperties.AutomationId="SyncDraftQueueButton" Command="{x:Bind ViewModel.SyncDraftQueueCommand}" Content="Sync from MFL" />
                <Button Grid.Column="5" AutomationProperties.AutomationId="SaveDraftQueueButton" Command="{x:Bind ViewModel.SaveDraftQueueCommand}" Content="Save queue" />
            </Grid>
            <Grid x:Name="DraftBoardPanel" x:Load="{x:Bind ViewModel.IsDraftPage, Mode=OneWay}" Grid.Row="4" Grid.RowSpan="2" RowSpacing="4" AutomationProperties.AutomationId="DraftBoardPanel">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Drafted picks" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AvailablePlayersTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" /></Grid>
                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Padding="12,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBlock Text="Order" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="1" Text="Player" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="2" Text="Pos" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="3" Text="NFL" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="4" Text="Fantasy team" Style="{StaticResource BodyStrongTextBlockStyle}" /></Grid>
                    <Grid Grid.Column="1" Padding="12,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.AvailableRankHeader, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="1" Text="Player" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="2" Text="Pos" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Column="3" Text="NFL" Style="{StaticResource BodyStrongTextBlockStyle}" /></Grid>
                </Grid>
                <ListView Grid.Row="2" AutomationProperties.AutomationId="DraftBoardList" ItemsSource="{x:Bind ViewModel.DraftBoard, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionMode="None" ShowsScrollingPlaceholders="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DraftBoardRow">
                            <Grid Padding="0,4" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Padding="12,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Order}" /><TextBlock Grid.Column="1" Text="{x:Bind DraftedPlayerName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{x:Bind DraftedPosition}" /><TextBlock Grid.Column="3" Text="{x:Bind DraftedNflTeam}" /><TextBlock Grid.Column="4" Text="{x:Bind FantasyTeamName}" TextTrimming="CharacterEllipsis" /></Grid>
                                <Grid Grid.Column="1" Padding="12,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind AvailableAdp}" /><TextBlock Grid.Column="1" Text="{x:Bind AvailablePlayerName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{x:Bind AvailablePosition}" /><TextBlock Grid.Column="3" Text="{x:Bind AvailableNflTeam}" /></Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.RowSpan="3" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" />
            </Grid>
            <Grid x:Name="ResultsHeader" x:Load="{x:Bind ViewModel.IsStandardDataPage, Mode=OneWay}" Grid.Row="4" Padding="12,8" ColumnSpacing="16" AutomationProperties.AutomationId="ResultsHeader">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ResultsPrimaryHeader, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ResultsSecondaryHeader, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ResultsTertiaryHeader, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.ResultsStatusHeader, Mode=OneWay}" FontWeight="SemiBold" />
            </Grid>
            <ListView x:Name="DataResults" x:Load="{x:Bind ViewModel.IsStandardDataPage, Mode=OneWay}" Grid.Row="5" AutomationProperties.AutomationId="CurrentPageResults" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" ShowsScrollingPlaceholders="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DisplayRow">
                        <Grid Padding="12,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Primary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Secondary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Tertiary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Status}" Foreground="{ThemeResource AppSuccessBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid x:Name="AgentPanel" x:Load="{x:Bind ViewModel.IsAgentPage, Mode=OneWay}" Grid.Row="3" Grid.RowSpan="3" ColumnSpacing="12" MinHeight="240">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="StartAgentButton" Command="{x:Bind ViewModel.StartAgentCommand}" Content="Start Luna" />
                        <Button AutomationProperties.AutomationId="StopAgentButton" Command="{x:Bind ViewModel.StopAgentCommand}" Content="Stop" />
                        <Button AutomationProperties.AutomationId="RestartAgentButton" Command="{x:Bind ViewModel.RestartAgentCommand}" Content="Restart" />
                        <TextBlock Text="{x:Bind ViewModel.TerminalState, Mode=OneWay}" VerticalAlignment="Center" />
                        <ToggleSwitch AutomationProperties.AutomationId="DraftAgentToggle" Header="Luna draft agent" IsOn="{x:Bind ViewModel.IsDraftAgentEnabled, Mode=TwoWay}" OffContent="Off" OnContent="On" />
                    </StackPanel>
                    <TextBox Grid.Row="1" AutomationProperties.AutomationId="CodexTerminal" AcceptsReturn="True" FontFamily="Cascadia Mono" IsReadOnly="True" Text="{x:Bind ViewModel.TerminalText, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="TerminalInput" AutomationProperties.AutomationId="CodexTerminalInput" AutomationProperties.Name="Codex terminal input" PlaceholderText="Send a prompt to Codex Luna" KeyDown="TerminalInput_KeyDown" />
                        <Button Grid.Column="1" AutomationProperties.AutomationId="SendTerminalInput" Content="Send" Click="SendTerminalInput_Click" />
                    </Grid>
                </Grid>
                <ListView Grid.Column="1" AutomationProperties.AutomationId="AgentActionHistory" ItemsSource="{x:Bind ViewModel.AgentHistory, Mode=OneWay}" />
            </Grid>
            <Grid Grid.Row="6" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LastRefresh, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>
    </NavigationView>
</Page>
