<UserControl
    x:Class="MflManager.App.Views.PlayerNameBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MflManager.App.Views">
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RosterStates">
                <VisualState x:Name="Bench" />
                <VisualState x:Name="Starter">
                    <VisualState.Setters>
                        <Setter Target="BadgeBorder.Background" Value="{ThemeResource PlayerNameStarterBackgroundBrush}" />
                        <Setter Target="NameText.Foreground" Value="{ThemeResource PlayerNameStarterForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="BadgeBorder" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                Padding="8,4" CornerRadius="{StaticResource ControlCornerRadius}"
                BorderThickness="1" BorderBrush="{ThemeResource PlayerStatusBorderBrush}"
                Background="{ThemeResource PlayerNameBenchBackgroundBrush}">
            <TextBlock x:Name="NameText" Text="{x:Bind PlayerName, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PlayerNameBenchForegroundBrush}" />
        </Border>
        <views:PlayerStatusBadge x:Name="StatusBadge" Grid.Column="1" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Status="{x:Bind Status, Mode=OneWay}" />
    </Grid>
</UserControl>
